        "    domain_rows.append({\"domain\": col, \"mean_F\": f.mean(), \"mean_M\": m.mean(),\n",
        "                        \"gap_M_minus_F\": m.mean() - f.mean(), \"cohens_d\": cohens_d(m, f),\n",
        "                        \"welch_p\": stats.ttest_ind(m, f, equal_var=False).pvalue})\n",
